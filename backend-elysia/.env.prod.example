# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
HOST=
HOST_URL=https://api.nktc-stu.com/api

# ─── Compose ports / container credentials ────────────────────────────────────
BACKEND_PORT=3001
POSTGRES_PORT=5434
POSTGRES_USER=replace-me
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=edu
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
MINIO_ROOT_USER=replace-me
MINIO_ROOT_PASSWORD=replace-me

# ─── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=6000s
BETTER_AUTH_SECRET=
BETTER_AUTH_ORIGIN=https://nktc-stu.com
BETTER_AUTH_RP_ID=nktc-stu.com
# Comma-separated full origins for additional trusted frontends
BETTER_AUTH_TRUSTED_ORIGINS=

# ─── Registration ──────────────────────────────────────────────────────────────
# Set to "true" to allow public registration in production
ALLOW_REGISTRATION=
# Secret key required for registration requests (header: x-registration-secret)
REGISTRATION_SECRET=

# ─── Admin Seed ────────────────────────────────────────────────────────────────
ADMIN_USERNAME=Admin01
ADMIN_PASSWORD=

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://replace-me:replace-me@postgres:5432/edu?schema=public&connection_limit=20&pool_timeout=0

# ─── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio.example.com
MINIO_PORT=9000
MINIO_USE_SSL=true
MINIO_BUCKET_NAME=nktc-app
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_DOMAINS=nktc-stu.com
CORS_DEV_ORIGINS=
CORS_MAX_AGE=86400
CORS_PRODUCTION_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# ─── App Settings ─────────────────────────────────────────────────────────────
EDUCATION_YEARS=2566
