{
  "name": "backend-elysia",
  "version": "1.0.5",
  "description": "NKTC Student Management System - Elysia Backend",
  "main": "src/index.ts",
  "scripts": {
    "test": "NODE_ENV=test bun test src/__tests__",
    "test:watch": "NODE_ENV=test bun test --watch src/__tests__",
    "test:coverage": "NODE_ENV=test bun test --coverage --coverage-reporter=lcov src/__tests__ && node scripts/coverage-summary.mjs",
    "dev": "bun --hot src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target bun --minify",
    "start": "bun dist/index.js",
    "prisma:generate": "bunx --bun prisma generate",
    "prisma:migrate": "bunx --bun prisma migrate dev",
    "prisma:migrate:deploy": "bunx --bun prisma migrate deploy",
    "prisma:push": "bunx --bun prisma db push",
    "seed": "bun prisma/seed.ts",
    "postinstall": "bun run prisma:generate"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.6.26",
    "@better-auth/prisma-adapter": "^1.6.26",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/client-runtime-utils": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.26",
    "dotenv": "^16.6.1",
    "elysia": "^1.4.29",
    "minio": "^8.0.7",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "ua-parser-js": "^2.0.10",
    "uuid": "^14.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "bun-types": "latest",
    "prisma": "^7.9.1",
    "prismabox": "^1.1.26",
    "typescript": "^5.9.3"
  }
}