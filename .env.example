# Copy this file to .env once, then run `bun run env`.
# The selector enables the chosen block and comments the other block.
# Keep secrets in this ignored .env file; never commit it.

# >>> NKTC_ENV:local
NODE_ENV=development
FRONTEND_PORT=3000
BACKEND_PORT=3001

# Frontend
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_PATH=/api/backend
BACKEND_INTERNAL_URL=http://localhost:3001/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_EDUCATION_YEARS=2567
ANALYZE=false
MUI_X_TELEMETRY_DISABLED=true
NEXT_PUBLIC_MUI_X_TELEMETRY_DISABLED=true

# Backend auth
JWT_SECRET=replace-with-a-local-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-local-refresh-secret-at-least-32-characters
JWT_REFRESH_EXPIRES_IN=7d
BETTER_AUTH_SECRET=replace-with-a-local-better-auth-secret-at-least-32-characters
BETTER_AUTH_ORIGIN=http://localhost:3000
BETTER_AUTH_RP_ID=localhost
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
ALLOW_REGISTRATION=true
REGISTRATION_SECRET=

# Local PostgreSQL / MinIO
POSTGRES_USER=backend1
POSTGRES_PASSWORD=backend1
POSTGRES_DB=backend1
DATABASE_URL=postgresql://backend1:backend1@localhost:5434/backend1?schema=public
MINIO_ENDPOINT=localhost
MINIO_PORT=9010
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=backend1-uploads
MINIO_ACCESS_KEY=backend1storage
MINIO_SECRET_KEY=backend1storage123

# Backend CORS and seed values
CORS_ALLOWED_DOMAINS=
CORS_DEV_ORIGINS=http://localhost:3000
CORS_MAX_AGE=86400
CORS_PRODUCTION_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
EDUCATION_YEARS=2567
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-me
# <<< NKTC_ENV:local

# >>> NKTC_ENV:prod
# NODE_ENV=production
# FRONTEND_PORT=3000
# BACKEND_PORT=3001

# Frontend
# NEXT_PUBLIC_APP_URL=https://app.example.com
# NEXT_PUBLIC_API_BASE_PATH=/api/backend
# BACKEND_INTERNAL_URL=http://backend:3001/api
# NEXT_PUBLIC_EDUCATION_YEARS=2567
# ANALYZE=false
# MUI_X_TELEMETRY_DISABLED=true
# NEXT_PUBLIC_MUI_X_TELEMETRY_DISABLED=true

# Backend auth
# JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# JWT_REFRESH_SECRET=replace-with-a-random-refresh-secret-at-least-32-characters
# JWT_REFRESH_EXPIRES_IN=7d
# BETTER_AUTH_SECRET=replace-with-a-random-better-auth-secret-at-least-32-characters
# BETTER_AUTH_ORIGIN=https://app.example.com
# BETTER_AUTH_RP_ID=app.example.com
# BETTER_AUTH_TRUSTED_ORIGINS=https://app.example.com
# ALLOW_REGISTRATION=
# REGISTRATION_SECRET=replace-me

# Production PostgreSQL / MinIO
# DATABASE_URL=postgresql://db_user:db_password@db.example.com:5432/edu?schema=public
# MINIO_ENDPOINT=minio.example.com
# MINIO_PORT=9000
# MINIO_USE_SSL=true
# MINIO_BUCKET_NAME=nktc-app
# MINIO_ACCESS_KEY=replace-me
# MINIO_SECRET_KEY=replace-me

# Backend CORS and seed values
# CORS_ALLOWED_DOMAINS=app.example.com
# CORS_DEV_ORIGINS=
# CORS_MAX_AGE=86400
# CORS_PRODUCTION_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
# EDUCATION_YEARS=2567
# ADMIN_USERNAME=Admin01
# ADMIN_PASSWORD=replace-me
# <<< NKTC_ENV:prod
